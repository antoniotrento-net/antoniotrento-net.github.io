---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
    {% assign skip = false %}
    {% if page.url == '/404.html' or page.redirect == true or page.sitemap == false %}{% assign skip = true %}{% endif %}
    {% if page.url == '/blog/' or page.url == '/blog' or page.url contains '/blog/page' %}{% assign skip = true %}{% endif %}
    {% unless skip %}
      <url>
        <loc>{{ site.url }}{{ page.url }}</loc>
      </url>
    {% endunless %}
  {% endfor %}

  {% for item in site.portfolio %}
    <url>
      <loc>{{ site.url }}{{ item.url }}</loc>
    </url>
  {% endfor %}
</urlset>
